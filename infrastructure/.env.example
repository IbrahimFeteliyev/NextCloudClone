POSTGRES_DB=atlas_demo
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas-local-demo
MINIO_ROOT_USER=atlas-local
MINIO_ROOT_PASSWORD=atlas-storage-demo

# Start-OnlyOfficeDemo.ps1 generates a random secret into the ignored .env if empty.
# The same environment variable is imported by the API and used as Docker JWT_SECRET.
OnlyOffice__JwtSecret=
OnlyOffice__DocumentServerUrl=http://localhost:8082
OnlyOffice__InternalUrl=http://localhost:8082
OnlyOffice__ApiUrl=http://host.docker.internal:5050
OnlyOffice__SessionHours=24
ONLYOFFICE_PORT=8082
